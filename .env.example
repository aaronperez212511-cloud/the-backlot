# Copy to .env and fill in — .env is gitignored, never commit real values.

# ClickHouse Cloud (sign up at clickhouse.com/cloud with the hackathon
# $400 credit link from the Agentic Cinema resources page)
CLICKHOUSE_HOST=your-instance.clickhouse.cloud
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# Google Cloud / Vertex AI.
# GOOGLE_GENAI_USE_VERTEXAI is REQUIRED: without it the ADK agents default to
# the AI Studio backend and fail with "No API key was provided", even though
# the project has Vertex AI enabled and Application Default Credentials set.
GOOGLE_CLOUD_PROJECT=the-backlot-fleet
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=TRUE
